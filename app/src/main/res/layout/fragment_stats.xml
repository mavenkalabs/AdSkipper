<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:padding="16dp"
    app:strokeWidth="2dp">

    <TableLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:clipToPadding="false">

        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceContainer">

            <TextView
                android:id="@+id/stats_this_cycle_prefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_stats_current_prefix"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

            <TextView
                android:id="@+id/stats_this_cycle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/msg_engagement_text"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
        </TableRow>

        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/stats_past_cycle_prefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_stats_past_prefix"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

            <TextView
                android:id="@+id/stats_past_cycle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/msg_engagement_text"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
        </TableRow>

        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceContainer">

            <TextView
                android:id="@+id/stats_lifetime_prefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_stats_lifetime_prefix"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />

            <TextView
                android:id="@+id/stats_lifetime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/msg_engagement_text"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
        </TableRow>

    </TableLayout>
</com.google.android.material.card.MaterialCardView>