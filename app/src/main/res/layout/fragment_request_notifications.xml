<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_gravity="center">
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_enable_notifications"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_request_notifications"
        style="@style/Widget.Material3Expressive.Button.OutlinedButton"
        app:cornerRadius="4dp"/>
    <TextView
        android:id="@+id/textview_rationale"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/msg_notifications_rationale"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"/>
</LinearLayout>