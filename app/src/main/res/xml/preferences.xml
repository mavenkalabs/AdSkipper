<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory android:title="@string/title_category_general"
        app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            app:key="@string/pref_key_mute_ads"
            app:iconSpaceReserved="false"
            app:title="@string/label_mute_ads"
            app:summary="@string/label_mute_ads_desc"
            app:defaultValue="true" />
        <SwitchPreferenceCompat
            android:defaultValue="false"
            app:iconSpaceReserved="false"
            android:key="@string/pref_key_enable_logging"
            android:title="@string/label_enable_logging"
            android:summary="@string/label_enable_logging_desc"/>
        <Preference
            app:isPreferenceVisible="false"
            app:iconSpaceReserved="false"
            android:key="@string/pref_key_dump_logs"
            android:title="@string/label_dump_logs"
            android:summary="@string/label_dump_logs_desc" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/title_category_pro"
        android:key="@string/pref_key_pro_settings"
        app:isPreferenceVisible="false"
        app:iconSpaceReserved="false">
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="@string/pref_key_pro_enable_voice"
            app:iconSpaceReserved="false"
            android:title="@string/label_voice"
            android:summary="@string/label_voice_desc"/>

    </PreferenceCategory>
</PreferenceScreen>